local toolTypes = {}
local toolList = {}
local buttons = {}
local selectedType = nil

function refreshToolList()
    mapFolder = workspace:FindFirstChild("Map")
    if not mapFolder then
        if autoRefreshEnabled then
            statusLabel.Text = "等待 workspace.Map 出现..."
        end
        return false
    end
    
    if autoRefreshEnabled then
        statusLabel.Text = "正在扫描物品..."
    end
    
    local previousSelected = selectedType
    
    toolTypes = {}
    toolList = {}
    
    for _, item in pairs(mapFolder:GetDescendants()) do
        if item:IsA("Tool") then
            local toolName = item.Name
            if not toolTypes[toolName] then
                toolTypes[toolName] = true
                toolList[toolName] = {}
            end
            table.insert(toolList[toolName], item)
        end
    end
    
    local typeNames = {}
    for name in pairs(toolTypes) do
        table.insert(typeNames, name)
    end
    table.sort(typeNames)
    
    for _, btn in pairs(buttons) do
        btn:Destroy()
    end
    buttons = {}
    
    if #typeNames == 0 then
        if autoRefreshEnabled then
            statusLabel.Text = "未找到任何 Tool 物品，等待刷新..."
        end
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
        selectedType = nil
        return false
    end
    
    for _, typeName in pairs(typeNames) do
        local count = #toolList[typeName]
        
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -10, 0, 35)
        btn.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
        btn.Text = typeName .. " (" .. count .. "个)"
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 14
        btn.Parent = scrollFrame
        
        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 4)
        btnCorner.Parent = btn
        
        btn.MouseButton1Click:Connect(function()
            selectedType = typeName
            for _, b in pairs(buttons) do
                b.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
            end
            btn.BackgroundColor3 = Color3.fromRGB(70, 130, 200)
            statusLabel.Text = "已选中: " .. typeName
        end)
        
        if typeName == previousSelected then
            selectedType = typeName
            btn.BackgroundColor3 = Color3.fromRGB(70, 130, 200)
        end
        
        table.insert(buttons, btn)
    end
    
    scrollFrame.CanvasSize = UDim2.new(0, 0, 0, #typeNames * 40)
    if autoRefreshEnabled then
        if selectedType then
            statusLabel.Text = "已找到 " .. #typeNames .. " 种物品，已选中: " .. selectedType
        else
            statusLabel.Text = "已找到 " .. #typeNames .. " 种物品"
        end
    end
    return true
end

function startRefreshLoop()
    if refreshLoopConnection then
        task.cancel(refreshLoopConnection)
        refreshLoopConnection = nil
    end
    
    refreshLoopConnection = task.spawn(function()
        while screenGui and screenGui.Parent and autoRefreshEnabled do
            refreshToolList()
            task.wait(2)
        end
    end)
end

local function teleportToolToFace(tool, facePos)
    for _, part in pairs(tool:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = false
            part.CanCollide = false
        end
    end
    
    local handle = tool:FindFirstChild("Handle")
    if handle and handle:IsA("BasePart") then
        handle.CFrame = facePos
        handle.Velocity = Vector3.new(0, 5, 0)
    else
        for _, part in pairs(tool:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CFrame = facePos
                part.Velocity = Vector3.new(0, 5, 0)
                break
            end
        end
    end
    
    task.wait(0.1)
    
    for _, part in pairs(tool:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = true
        end
    end
end

function teleportAllTools()
    local currentMapFolder = workspace:FindFirstChild("Map")
    if not currentMapFolder then
        statusLabel.Text = "未找到 workspace.Map"
        return
    end
    
    local allTools = {}
    for _, item in pairs(currentMapFolder:GetDescendants()) do
        if item:IsA("Tool") and item.Parent then
            table.insert(allTools, item)
        end
    end
    
    if #allTools == 0 then
        statusLabel.Text = "没有找到任何物品可传送"
        return
    end
    
    local character = player.Character
    if not character then
        statusLabel.Text = "等待角色加载..."
        return
    end
    
    local head = character:FindFirstChild("Head")
    if not head then
        statusLabel.Text = "角色未就绪"
        return
    end
    
    statusLabel.Text = string.format("正在传送 %d 个物品...", #allTools)
    local facePos = head.CFrame * CFrame.new(0, -1, 2.5)
    local teleported = 0
    
    for _, tool in pairs(allTools) do
        if tool and tool.Parent then
            pcall(function()
                teleportToolToFace(tool, facePos)
                teleported = teleported + 1
                task.wait(0.1)
            end)
        end
    end
    
    statusLabel.Text = string.format("一键传送完成！共传送 %d 个物品", teleported)
    print(string.format("一键传送完成！共传送 %d 个物品", teleported))
    
    task.wait(0.5)
    refreshToolList()
end

teleportBtn.MouseButton1Click:Connect(function()
    if not selectedType then
        statusLabel.Text = "请先选择一个物品类型"
        return
    end
    
    local items = toolList[selectedType]
    if not items or #items == 0 then
        refreshToolList()
        items = toolList[selectedType]
        if not items or #items == 0 then
            statusLabel.Text = "选中的物品已不存在，请重新选择"
            selectedType = nil
            return
        end
    end
    
    local character = player.Character
    if not character then
        statusLabel.Text = "等待角色加载..."
        return
    end
    
    local head = character:FindFirstChild("Head")
    if not head then
        statusLabel.Text = "角色未就绪"
        return
    end
    
    local facePos = head.CFrame * CFrame.new(0, -1, 2.5)
    
    local amountStr = amountInput.Text
    local amountToTake = #items
    if amountStr ~= "全部" and tonumber(amountStr) then
        amountToTake = math.min(tonumber(amountStr), #items)
    end
    
    local teleported = 0
    
    for i = 1, amountToTake do
        local tool = items[i]
        if tool and tool.Parent then
            pcall(function()
                teleportToolToFace(tool, facePos)
                teleported = teleported + 1
                task.wait(0.1)
            end)
        end
    end
    
    statusLabel.Text = string.format("已将 %d 个 %s 传送到脸上", teleported, selectedType)
    print(string.format("已将 %d 个 %s 传送到脸上", teleported, selectedType))
    
    task.wait(0.5)
    refreshToolList()
end)

